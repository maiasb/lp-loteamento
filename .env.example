# Copie para .env.local (dev) ou defina no shell/pipeline do build. Nunca commitar valores reais.
# Tudo aqui é NEXT_PUBLIC_*: vai para o navegador e é embutido no build (troque o valor e refaça o build).
# O build de produção falha com valor ausente ou placeholder (CA-33).

# WhatsApp: só dígitos, com 55 + DDD + número (ex.: 5511912345678)
NEXT_PUBLIC_WHATSAPP=CONFIGURAR
NEXT_PUBLIC_CONTACT_EMAIL=CONFIGURAR@example.com
# URL pública do site, sem barra final (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endereço de envio dos leads: URL do aplicativo da web do Apps Script (https://script.google.com/macros/s/.../exec).
# É público (quem vê o código da página o conhece). Em produção só aceita script.google.com.
NEXT_PUBLIC_LEADS_ENDPOINT=CONFIGURAR
# Desenvolvimento/QA sem Google: yarn leads:mock sobe um endpoint simulado e
# NEXT_PUBLIC_LEADS_ENDPOINT=http://127.0.0.1:8787/leads o usa com `yarn dev`. Para gerar um `out/`
# contra o mock use LEADS_ALLOW_LOOPBACK=1 no shell (nunca em build de publicação; ver README).
